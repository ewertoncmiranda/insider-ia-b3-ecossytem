# Modelo do arquivo `.env.ia` (copie para `.env.ia` nesta pasta; ele e ignorado pelo git).
# Aqui ficam so os NOMES das variaveis, sem valores. A chave nunca vai para codigo, log, SPEC ou teste.
# Padroes e significado: SPEC.md secao 13.5 e DEC-IA-09/10.

# Chave da API do Gemini (AI Studio). Vazia: o Gemini fica indisponivel e o servico responde pela regra (chat indisponivel).
GEMINI_API_KEY=

# Modelos na ordem de tentativa e limites RPM/RPD de cada um, na mesma ordem. Confirme os ids no AI Studio.
# GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# GEMINI_LIMITES=15/500,15/500,5/20
# Reserva para modelo sem entrada em GEMINI_LIMITES (o menor limite do nivel gratuito).
# GEMINI_RPM=5
# GEMINI_RPD=20
# GEMINI_TIMEOUT_S=30

# Provedores: so Gemini desde 2026-10-08 (DEC-IA-11). Sem Gemini, lote e card caem na regra.
# PROVEDORES_LOTE=gemini
# PROVEDORES_CHAT=gemini

# Divisao do teto diario entre chat, card e lote (soma 100).
# COTA_CHAT_PCT=40
# COTA_CARD_PCT=20
# COTA_LOTE_PCT=40

# Limite do chat por sessao.
# CHAT_MAX_DIA_SESSAO=60
# CHAT_INTERVALO_S=3
